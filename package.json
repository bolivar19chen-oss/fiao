{
  "name": "fiao",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/next-dist.mjs build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "clean": "node scripts/clean.mjs",
    "format:check": "prettier --check .",
    "gen:types": "supabase gen types typescript --linked --schema public > shared/types/database.ts && prettier --write shared/types/database.ts",
    "predev": "node scripts/check-dev-port.mjs",
    "start": "node scripts/next-dist.mjs start"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "cobe": "2.0.1",
    "framer-motion": "12.43.0",
    "lucide-react": "^1.57.0",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "jsdom": "^30.1.3",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
