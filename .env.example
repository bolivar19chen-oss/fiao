# Copiar a .env.local y completar con los valores del proyecto en Supabase
# (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A donde vuelven los enlaces del correo de confirmacion. Sin esto se usa el puerto donde
# corria el servidor al enviarlo, y si Next arranco en otro puerto el enlace apunta a un
# lugar donde ya no hay nada: "localhost rechazo la conexion".
# En desarrollo: http://localhost:3000. En produccion: el dominio real.
# El mismo valor tiene que estar en Supabase, Authentication > URL Configuration,
# como Site URL y dentro de Redirect URLs (ahi con /auth/callback al final).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
